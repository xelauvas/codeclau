#!/bin/bash
# Xela — AI coding assistant powered by open-source models
#
# Usage:
#   xela                    # interactive mode
#   xela "fix the bug"      # with prompt
#   xela -m model_id        # override model
#
# Configure in ~/.xela/config (auto-created on first run)

XELA_HOME="${XELA_HOME:-$HOME/.xela}"
XELA_CONFIG="$XELA_HOME/config"

# Resolve install dir (works whether symlinked or npm-installed)
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
INSTALL_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

# Create config on first run
if [ ! -f "$XELA_CONFIG" ]; then
  mkdir -p "$XELA_HOME"
  cat > "$XELA_CONFIG" << 'EOF'
# Xela Configuration
# Provider: openrouter, groq, ollama, deepseek, openai, cerebras, sambanova
XELA_PROVIDER=openrouter

# API Keys (uncomment and fill in the one you use)
OPENAI_API_KEY=sk-or-your-key-here
# OPENAI_API_KEY=gsk_your-groq-key
# OPENAI_API_KEY=ollama

# Model (auto-detected from provider if not set)
# OPENAI_MODEL=qwen/qwen3.6-plus-preview:free
# OPENAI_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Base URL (auto-detected from provider if not set)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=http://localhost:11434/v1
EOF
  echo "┌─────────────────────────────────────────┐"
  echo "│  Welcome to Xela!                       │"
  echo "│  Config created at ~/.xela/config        │"
  echo "│  Edit it: nano ~/.xela/config            │"
  echo "└─────────────────────────────────────────┘"
  echo ""
fi

# Load config
source "$XELA_CONFIG"

# Auto-detect base URL from provider if not explicitly set
if [ -z "$OPENAI_BASE_URL" ]; then
  case "$XELA_PROVIDER" in
    openrouter)  export OPENAI_BASE_URL="https://openrouter.ai/api/v1" ;;
    groq)        export OPENAI_BASE_URL="https://api.groq.com/openai/v1" ;;
    ollama)      export OPENAI_BASE_URL="http://localhost:11434/v1" ;;
    deepseek)    export OPENAI_BASE_URL="https://api.deepseek.com" ;;
    cerebras)    export OPENAI_BASE_URL="https://api.cerebras.ai/v1" ;;
    sambanova)   export OPENAI_BASE_URL="https://api.sambanova.ai/v1" ;;
  esac
fi

# Auto-detect model from provider if not explicitly set
if [ -z "$OPENAI_MODEL" ]; then
  case "$XELA_PROVIDER" in
    openrouter)  export OPENAI_MODEL="qwen/qwen3.6-plus-preview:free" ;;
    groq)        export OPENAI_MODEL="qwen-qwq-32b" ;;
    ollama)      export OPENAI_MODEL="qwen2.5-coder:7b" ;;
    deepseek)    export OPENAI_MODEL="deepseek-chat" ;;
    openai)      export OPENAI_MODEL="gpt-4o" ;;
    cerebras)    export OPENAI_MODEL="llama-3.3-70b" ;;
    sambanova)   export OPENAI_MODEL="Meta-Llama-3.3-70B-Instruct" ;;
  esac
fi

export OPENAI_API_KEY
export OPENAI_BASE_URL
export OPENAI_MODEL

# Handle -m flag for model override
while [ $# -gt 0 ]; do
  case "$1" in
    -m|--model)
      export OPENAI_MODEL="$2"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

exec node \
  --import "$INSTALL_DIR/src/_shims/register.js" \
  "$INSTALL_DIR/start.js" \
  "$@"
